# Application
APP_NAME="LangGraph Workflows"
APP_VERSION="0.1.0"
DEBUG=false
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8004

# LangGraph
CHECKPOINT_DIR=./data/checkpoints
THREAD_POOL_SIZE=10

# LLM
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_PROVIDER=openai
DEFAULT_TEMPERATURE=0.7

# Streaming
STREAM_TOKENS=true
STREAM_MODE=messages

# Visualization
ENABLE_VISUALIZER=true
VISUALIZER_PORT=8080

# Debug
DEBUG_CHECKPOINTS=true
MAX_DEBUG_HISTORY=1000